def cmd_purge(args: Optional[list] = None):
    """
    Complete service deletion & Docker teardown:
    - Stops all containers
    - Removes containers, networks, and persistent named volumes (docker compose down -v)
    - Prunes dangling images, volume layers, and build cache
    - Optionally removes Nginx virtualhost configurations
    """
    if args and ("-h" in args or "--help" in args):
        print(f"\n{BOLD}Usage:{NC} ./aura purge [OPTIONS]")
        print("\nComplete platform teardown: stops and deletes all Docker containers, volumes, networks, and caches.")
        print(f"\n{BOLD}Options:{NC}")
        print("  -y, --yes, -f, --force   Non-interactive mode, skip confirmation prompt.")
        print("  -h, --help               Show this help message and exit.\n")
        return

    is_force = False
    if args:
        is_force = "-y" in args or "--yes" in args or "--force" in args or "-f" in args

    print("\n" + "=" * 80)
    print(f"{RED}{BOLD}⚠️  DANGER: COMPLETE PLATFORM TEARDOWN & SERVICE DELETION{NC}")
    print("=" * 80)
    print("This action will:")
    print(f"  • {RED}STOP & DELETE{NC} all 11 NextAura Docker containers")
    print(f"  • {RED}PERMANENTLY WIPE{NC} all metrics TSDB, logs, and trace volumes (`docker compose down -v`)")
    print(f"  • {RED}REMOVE{NC} the Docker network (`monitoring_net`)")
    print(f"  • {RED}PRUNE{NC} dangling Docker images and build caches")
    print("=" * 80)

    if not is_force:
        confirm = input(f"\n{RED}{BOLD}Are you absolutely sure you want to delete all services and wipe data? (type 'yes' to confirm): {NC}").strip()
        if confirm.lower() != "yes":
            print(f"\n{GREEN}Operation cancelled. No services were modified.{NC}\n")
            return

    print(f"\n{YELLOW}[1/4] Stopping and removing all Docker containers & named volumes...{NC}")
    cmd = get_compose_cmd() + ["down", "-v", "--remove-orphans"]
    subprocess.run(cmd, cwd=REPO_ROOT)
    print(f"  {GREEN}✓ Containers and persistent volumes removed.{NC}")

    print(f"\n{YELLOW}[2/4] Pruning dangling Docker volumes and build caches...{NC}")
    subprocess.run(["docker", "volume", "prune", "-f"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    subprocess.run(["docker", "builder", "prune", "-f"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"  {GREEN}✓ Docker artifacts cleaned.{NC}")

    print(f"\n{YELLOW}[3/4] Cleaning ephemeral log buffers in /tmp/vps_monitoring_logs...{NC}")
    subprocess.run(["rm", "-rf", "/tmp/vps_monitoring_logs"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(f"  {GREEN}✓ Ephemeral log buffers cleaned.{NC}")

    # Optional Nginx site decommissioning
    if not is_force:
        clean_nginx = input(f"\nDo you also want to remove registered Nginx projects & virtual hosts? (y/N): ").strip().lower()
        if clean_nginx in ("y", "yes"):
            try:
                from utils.storage import StateManager
                from core.nginx_manager import NginxManager
                sm = StateManager()
                nm = NginxManager()
                projs = sm.list_projects()
                for p in projs:
                    print(f"  • Decommissioning Nginx project: {p.project_name} ({p.project_code})...")
                    nm.remove_config(p.project_name)
                    sm.delete_project(p.project_name)
                print(f"  {GREEN}✓ All registered Nginx projects decommissioned.{NC}")
            except Exception as e:
                print(f"  {YELLOW}Notice: {e}{NC}")

    print(f"\n{GREEN}================================================================")
    print(f" 🎉 COMPLETE TEARDOWN FINISHED: ALL SERVICES SAFELY REMOVED")
    print(f"================================================================{NC}")
    print(f"• To redeploy the platform anytime, simply run: {CYAN}./aura up{NC} or {CYAN}./aura menu{NC}\n")

