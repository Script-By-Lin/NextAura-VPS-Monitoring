def main():
    if len(sys.argv) == 1:
        # Default with no arguments: open Master Control Center
        cmd_menu()
        return

    subcmd = sys.argv[1].lower().lstrip("-")
    if subcmd in ("h", "help"):
        print_help()
        return

    handler = COMMAND_MAP.get(subcmd)
    if handler:
        handler(sys.argv[2:])
    else:
        print(f"{RED}Unknown command: '{sys.argv[1]}'{NC}")
        print(f"Run {CYAN}./aura help{NC} for all available commands.")
        sys.exit(1)

if __name__ == "__main__":
    main()
