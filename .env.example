# ==============================================================================
# VPS Monitoring Platform Environment Configuration
# ==============================================================================

# Project & Deployment Info
COMPOSE_PROJECT_NAME=vps_monitoring
SERVER_HOSTNAME=localhost
ENVIRONMENT=production

# Security & Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_secure_pass_change_me
PROMETHEUS_BASIC_AUTH_USER=admin
PROMETHEUS_BASIC_AUTH_PASS=prom_secure_pass_change_me

# Telegram Alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Alerting (Fallback)
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM=alerts@example.com
SMTP_AUTH_USERNAME=
SMTP_AUTH_PASSWORD=
ALERT_EMAIL_TO=admin@example.com

# Service Ports (Binding)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
LOKI_PORT=3100
TEMPO_PORT=3200
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
FASTAPI_PORT=8000
NODE_EXPORTER_PORT=9100
CADVISOR_PORT=8080
BLACKBOX_PORT=9115

# Retention Policies
PROMETHEUS_RETENTION_TIME=30d
LOKI_RETENTION_PERIOD=720h

# Fail2ban Settings
FAIL2BAN_FINDTIME=600
FAIL2BAN_MAXRETRY=5
FAIL2BAN_BANTIME=3600
FAIL2BAN_WHITELIST=127.0.0.1/8 ::1
